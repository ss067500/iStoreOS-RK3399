+CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x300000
+CONFIG_DEFAULT_DEVICE_TREE="rk3399-h339pc"
+CONFIG_ROCKCHIP_RK3399=y
+CONFIG_SPL_ROCKCHIP_COMMON_BOARD_F=y
+CONFIG_SPL_MMC=y
+CONFIG_SPL_SERIAL=y
+CONFIG_SPL_STACK_R_ADDR=0x600000
+CONFIG_TARGET_EVB_RK3399=y
